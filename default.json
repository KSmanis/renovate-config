{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    ":enablePreCommit"
  ],
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|\\/)linuxserver\\//"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)((\\.|-r)(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "SonarSource/sonarqube-scan-action",
        "shellcheck-py/shellcheck-py"
      ],
      "versioning": "loose"
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "matchManagers": [
        "custom.regex",
        "docker-compose",
        "dockerfile",
        "github-actions",
        "mise",
        "pre-commit"
      ]
    },
    {
      "automerge": false,
      "matchManagers": [
        "custom.regex",
        "docker-compose",
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "groupName": "uv",
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "matchDepNames": [
        "astral-sh/uv",
        "astral-sh/uv-pre-commit"
      ]
    },
    {
      "automerge": false,
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "description": "Reduce noisy updates",
      "matchPackageNames": [
        "renovatebot/pre-commit-hooks"
      ],
      "schedule": [
        "before 4am on monday"
      ]
    }
  ],
  "pyenv": {
    "enabled": false
  }
}
